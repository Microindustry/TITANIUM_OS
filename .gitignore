# TITANIUM_OS — .gitignore
_VAULT/
BACKUPS/
*.pyc
__pycache__/
.env
*.log
VERSIONS/snapshots/
# Archivi changelog auto-generati (loop runaway del watcher) — ridondanti con git history
VERSIONS/changelog_archive_*.md
node_modules/
dist/
.vite/
# ChromaDB + RAG internals — si rebuild da MENTE/, possono contenere dati sensibili
NODES/MENTE_RAG/chroma_db/
NODES/MENTE_RAG/chroma_db_*/
NODES/MENTE_RAG/rag_corpus.jsonl
NODES/MENTE_RAG/rag_manifest.json
NODES/MENTE_RAG/rag_manifest_*.json
NODES/MENTE_RAG/rag_tfidf.pkl
NODES/MENTE_RAG/rag_linkgraph.json
NODES/MENTE_RAG/mente_index.json
# device override machine-local (cpu/cuda) — come .env, non versionare
NODES/MENTE_RAG/rag_device.txt
# Indice semantico (binario) — rigenerabile da MENTE/, riscritto di continuo dal watcher (churn)
DATA/semantic_index.db
DATA/daily_brief_last.md
DATA/computer_use_shots/
# EVA — config con dati reali del centro (orari/servizi/clienti): non versionare
NODES/EVA/config.json
# EVA runtime: inbox handoff (PII cliente) + stato sessioni — MAI in git
DATA/eva/
MODELS/
CONTENT_ENGINE/DATABASE/training/dataset.jsonl

DATA/dash_shot*.png
DATA/mockup_*.png
DATA/dash_*.png
DATA/pitch*.png
DATA/home*.png

NODES/COMPUTER_USE/omniparser_weights/
*.safetensors

# Contiene token/segreti locali (GH_TOKEN, PATH macchina) — MAI in git
ti_autorun.cmd
# Graphify (knowledge graph): output rigenerabile, può contenere estratti di MENTE/ — resta locale
graphify-out/
**/graphify-out/
# AI News Watcher: stato runtime (criticità a ogni passata) — roster in codice + BRAIN/brief
DATA/ai_news_watcher_state.json
# Sync incrementale: stamp hash per non rifare lavoro inutile
DATA/.sync_bussola.hash
DATA/.sync_pct.hash
DATA/.inventario_last.txt
# pct_sync: report rigenerato a ogni run (runtime, non sorgente)
DATA/audit/pct_sync.json
# Viste markdown: cache rigenerabile da AUTOMATIONS/core/md_view_pipeline.py
# (340 file .md.json + indice riscritti a ogni sweep -> churn che sporca ogni diff).
# Restano su disco (la dashboard li serve via /api/file); fuori da git. (critica AUD-28de0ccc64)
DATA/views/
DATA/view_index.json
